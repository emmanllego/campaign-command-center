# Copy to .env.local for local development (never commit real values).
# On Vercel, set these in Project → Settings → Environment Variables.

# --- Access ---------------------------------------------------------------
# Shared workspace password. REQUIRED in production: without it the data and
# AI routes refuse to run on a Vercel production deployment.
APP_PASSWORD=
# Optional: separate secret for signing session cookies (defaults to APP_PASSWORD).
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# --- AI (server-side only) -------------------------------------------------
# Set ONE of these keys. If both are set, Anthropic is used unless AI_PROVIDER says otherwise.
# Anthropic API key from https://platform.claude.com (Settings → API keys).
ANTHROPIC_API_KEY=
# OpenAI API key from https://platform.openai.com (API keys).
OPENAI_API_KEY=
# Optional overrides
AI_PROVIDER=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
OPENAI_MODEL=gpt-6-astra

# --- Database --------------------------------------------------------------
# Upstash Redis REST credentials. Vercel's Upstash integration injects the
# KV_REST_API_* names automatically; UPSTASH_REDIS_REST_* also work.
# Leave empty locally to use the file store at .data/workspace.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: key prefix, lets several deployments share one Redis database.
STORE_PREFIX=ccc:ws:
